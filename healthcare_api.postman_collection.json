            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe Jr.\",\n  \"date_of_birth\": \"1992-06-15\",\n  \"gender\": \"Male\",\n  \"phone\": \"+1-555-0188\",\n  \"email\": \"john.doejr@example.com\",\n  \"address\": \"742 Evergreen Terrace Apt 2, Springfield\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
