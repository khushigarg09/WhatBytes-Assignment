            "description": "Update details of an owned patient. Returns 404 for unowned records."
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}", ""]
            },
            "description": "Delete an owned patient. Returns 404 for unowned records."
          }
        }
      ]
    },
